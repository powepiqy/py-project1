#NP‑M1

def angles_to(query, X):
    q_norm = np.linalg.norm(query)
    if np.allclose(q_norm, 0):
        raise ValueError("query不能为零向量")
    x_norms = np.linalg.norm(X, axis=1)
    dot_mat = X @ query
    cos_arr = dot_mat / (q_norm * x_norms)
    #求反余弦前 clip 到 [-1,1]
    cos_arr = np.clip(cos_arr, -1.0, 1.0)
    angles_rad = np.arccos(cos_arr)
    angles_deg_out = np.rad2deg(angles_rad)
    # X中零向量行置np.nan
    zero_mask = np.allclose(x_norms, 0)
    angles_deg_out[zero_mask] = np.nan
    return angles_deg_out


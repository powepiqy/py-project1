# NP‑M2

def top_k_cosine(query, gallery, k):
    q_norm = np.linalg.norm(query)
    if np.allclose(q_norm, 0):
        raise ValueError("query不能为零向量")
    g_norms = np.linalg.norm(gallery, axis=1)
    # 过滤零向量行（non对应“~”）
    non_zero_mask = ~np.isclose(g_norms, 0)
    valid_gallery = gallery[non_zero_mask]
    valid_idx = np.nonzero(non_zero_mask)[0]
    valid_count = len(valid_gallery)
    #k 必须为正整数且不超过有效行数，否则抛出 ValueError；输出选中 ID
    if not isinstance(k, int) or k <= 0 or k > valid_count:
        raise ValueError("k必须为正整数，且不超过有效行数")

    dot = valid_gallery @ query
    sim = dot / (q_norm * g_norms[non_zero_mask])

    # argsort stable：分数相同保持原顺序；取最大k个（-sim做降序）；返回下标
    order = np.argsort(-sim, kind="stable")
    top_k_local = order[:k]
    top_global_idx = valid_idx[top_k_local]
    top_sim = sim[top_k_local]
    return top_global_idx, top_sim

query_m2 = np.array([0.60, -0.80, 0.00])
gallery_m2 = np.array([[0.60, -0.80, 0.00],
                       [0.30, -0.40, 0.00],
                       [0.80, 0.60, 0.00],
                       [-0.60, 0.80, 0.00],
                       [0.00, 0.00, 0.00]])
ids_m2 = np.array(["img_a", "img_b", "img_c", "img_d", "img_zero"])

top_idx, top_sim = top_k_cosine(query_m2, gallery_m2, k=3)
print("top‑k索引:", top_idx)
print("top‑k相似度:", top_sim)
print("选中图片ID:", ids_m2[top_idx])


#  NP‑M3

A_m3 = np.array([[0.20, -0.40],
                 [-0.60, -0.20]])
B_m3 = np.array([[0.10, 0.20],
                 [0.80, 0.30],
                 [-0.50, 0.70]])

# 广播：A(N,2)扩展(N,1,2), B(M,2)扩展(1,M,2) → diff (N,M,2)
diff_ab = A_m3[:, np.newaxis, :] - B_m3[np.newaxis, :, :]
#计算距离矩阵 D，使 D[i,j] 表示 A[i] 到 B[j] 的距离
D = np.sqrt(np.sum(diff_ab ** 2, axis=-1))
print("距离矩阵D:\n", D)
print("D shape =", D.shape)

# A每一行找距离最近B的索引
nearest_b_idx = np.argmin(D, axis=1)
print("A每行距离最近B的行索引:", nearest_b_idx)



"""Project 1 的图像编码器。

使用 NumPy 完成 TODO-01 到 TODO-06。
模型参数和 helpers.py 由课程提供。
"""
import numpy as np
from helpers import LayerNorm, GELU, attention_weights, causal_mask, unit_vector


class MultiHeadAttention:
    def __init__(self, weights, prefix, heads):
        self.qkv_weight = weights[prefix + '.in_proj_weight']  # Q、K、V 的权重
        self.qkv_bias = weights[prefix + '.in_proj_bias']      # Q、K、V 的偏置
        self.out_weight = weights[prefix + '.out_proj.weight']  # 输出权重
        self.out_bias = weights[prefix + '.out_proj.bias']
        self.heads = heads
        self.width = self.out_bias.shape[0]
        self.head_dim = self.width // heads

    def split_heads(self, x):
        """TODO-02：把特征拆成多个注意力头。

        输入形状为 [B,N,D]，输出形状为 [B,H,N,D/H]。
        本实验中共有 12 个头，每个头的大小为 64。
        """
        # 先分出 head 这一维，再把它移到 token 维前面。
        batch, tokens, width = x.shape
        return x.reshape(batch, tokens, self.heads, self.head_dim).transpose(0, 2, 1, 3)

    def __call__(self, x, causal=False):
        # 课程给出的权重形状是 [输出大小, 输入大小]，所以这里要转置。
        qkv = x @ self.qkv_weight.T + self.qkv_bias
        q = self.split_heads(qkv[:, :, :self.width])
        k = self.split_heads(qkv[:, :, self.width:2*self.width])
        v = self.split_heads(qkv[:, :, 2*self.width:])

        # TODO-03a：计算 Q 和 K 的相似程度，并除以根号 64。
        # q、k、v 的形状为 [B,H,N,64]，scores 的形状为 [B,H,N,N]。
        scores = (q @ k.swapaxes(-1, -2)) / np.sqrt(np.float32(self.head_dim))

        # 图像编码时 causal=False，这一段是为了保留原来的接口。
        if causal:
            scores = causal_mask(scores)
        coefficients = attention_weights(scores)  # 使用课程提供的 softmax 函数

        # TODO-03b：用注意力系数对 V 加权，再把多个 head 合在一起。
        # context 的形状为 [B,H,N,64]，merged 的形状为 [B,N,D]。
        context = coefficients @ v
        # 合并前先把 token 维移回原来的位置。
        merged = context.transpose(0, 2, 1, 3).reshape(x.shape)

        # TODO-03c：做最后一次线性计算，输出形状仍为 [B,N,D]。
        return merged @ self.out_weight.T + self.out_bias


class TransformerBlock:
    def __init__(self, weights, prefix, heads):
        self.norm1 = LayerNorm(weights[prefix+'.ln_1.weight'], weights[prefix+'.ln_1.bias'])
        self.norm2 = LayerNorm(weights[prefix+'.ln_2.weight'], weights[prefix+'.ln_2.bias'])
        self.attention = MultiHeadAttention(weights, prefix+'.attn', heads)
        self.fc1_weight = weights[prefix+'.mlp.c_fc.weight']  # MLP 第一层权重
        self.fc1_bias = weights[prefix+'.mlp.c_fc.bias']
        self.fc2_weight = weights[prefix+'.mlp.c_proj.weight']  # MLP 第二层权重
        self.fc2_bias = weights[prefix+'.mlp.c_proj.bias']
        self.gelu = GELU()

    def __call__(self, x, causal=False):
        # 先归一化，再计算注意力结果。
        update = self.attention(self.norm1(x), causal=causal)

        # TODO-04a：第一次残差连接，把原输入加回来。
        residual = x + update

        # 第二次归一化。
        u = self.norm2(residual)

        # TODO-04b：经过两层 MLP，然后完成第二次残差连接。
        # hidden 的形状为 [B,N,3072]，mlp_update 为 [B,N,768]。
        hidden = self.gelu(u @ self.fc1_weight.T + self.fc1_bias)
        mlp_update = hidden @ self.fc2_weight.T + self.fc2_bias
        return residual + mlp_update


class ImageEncoder:
    def __init__(self, weights):
        self.patch_weight = weights['visual.conv1.weight'].reshape(768, 3072)
        self.cls = weights['visual.class_embedding'].reshape(1, 1, 768)
        self.position = weights['visual.positional_embedding']  # 位置编码
        self.pre_norm = LayerNorm(weights['visual.ln_pre.weight'], weights['visual.ln_pre.bias'])
        self.blocks = [TransformerBlock(weights, 'visual.transformer.resblocks.' + str(i), 12)
                       for i in range(12)]
        self.post_norm = LayerNorm(weights['visual.ln_post.weight'], weights['visual.ln_post.bias'])
        self.projection = weights['visual.proj']  # 把 768 维变成 512 维

    def patchify(self, images):
        """TODO-01：把图像分成 49 个小块。

        输入形状为 [B,3,224,224]，输出形状为 [B,49,3072]。
        每个小块大小为 32×32，按从左到右、从上到下排列。
        """
        # 先分出小块的行和列，再调整顺序并展开。
        batch = images.shape[0]
        # 调整后，每一行就是一个小块的数据。
        return images.reshape(batch, 3, 7, 32, 7, 32).transpose(0, 2, 4, 1, 3, 5).reshape(batch, 49, 3072)

    def embed(self, images):
        patches = self.patchify(images)  # 切分后的图像小块

        # TODO-05a：把每个小块从 3072 维变成 768 维，这里没有偏置。
        projected = patches @ self.patch_weight.T

        # 每张图片都要加入一个 CLS token。
        cls = np.tile(self.cls, (images.shape[0], 1, 1))

        # TODO-05b：把 CLS 放在最前面，再加上位置编码。
        # 输出形状为 [B,50,768]。
        return np.concatenate((cls, projected), axis=1) + self.position

    def encode_tokens(self, images):
        """依次通过 12 个 Transformer block。"""
        x = self.pre_norm(self.embed(images))
        for block in self.blocks:
            x = block(x)
        return x

    def __call__(self, images):
        """TODO-06：为每张图片生成一个 512 维单位向量。"""
        tokens = self.encode_tokens(images)

        # 取出 CLS token，归一化后再变成 512 维。
        output = self.post_norm(tokens[:, 0, :]) @ self.projection

        return unit_vector(output)
